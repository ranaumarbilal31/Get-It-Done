# TaskConnect Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite by default for zero-setup local dev)
# For PostgreSQL (Neon/Supabase/Render): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="taskconnect_dev_secret_key_change_in_production_998877"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Simulated Stripe Test Mode
STRIPE_SECRET_KEY="sk_test_mock_stripe_key_for_testing"

# Email Configuration (Brevo / Gmail SMTP - optional; console fallback if blank)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="TaskConnect <noreply@taskconnect.local>"

# Cloudinary Storage (optional; falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
