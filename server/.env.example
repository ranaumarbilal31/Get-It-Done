# Get It Done API — never commit real secrets
PORT=5000
NODE_ENV=development
# Render defaults to one trusted reverse-proxy hop; local servers trust none.
# Override only to match the actual network topology.
# TRUST_PROXY_HOPS=1
DATABASE_URL="file:./dev.db"
# Production uses a persistent PostgreSQL URL; npm start selects its schema.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
# Optional comma-separated additional trusted socket/browser origins.
ALLOWED_ORIGINS=""
PUBLIC_SITE_URL="https://get-it-done-steel.vercel.app"
# Account-security emails are sent over HTTPS to the signed Vercel Gmail relay.
EMAIL_RELAY_URL="https://get-it-done-steel.vercel.app/api/account-email"
EMAIL_RELAY_SECRET=""
# Configure these only in Vercel, not the API's public environment or frontend:
# GMAIL_USER=phalanx.getitdone@gmail.com
# GMAIL_APP_PASSWORD=<Gmail app password>
# EMAIL_RELAY_SECRET=<same random secret as Render>
# Cloudinary is recommended for persistent public image storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
