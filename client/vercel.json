{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://taskconnect-api.onrender.com wss://taskconnect-api.onrender.com https://*.onrender.com https://*.tile.openstreetmap.org; frame-ancestors 'none'; frame-src 'self' blob:;"
        }
      ]
    },
    {
      "source": "/template.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/render"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?path=sitemap.xml"
    },
    {
      "source": "/sitemap-:part(\\d+).xml",
      "destination": "/api/sitemap?path=sitemap-:part.xml"
    },
    {
      "source": "/api/((?!render(?:/|$)|sitemap(?:/|$)|account-email(?:/|$)).*)",
      "destination": "https://taskconnect-api.onrender.com/api/$1"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://taskconnect-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/render?path=:path*"
    }
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/**"
    }
  }
}
